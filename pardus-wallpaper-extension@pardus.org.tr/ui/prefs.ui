<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="PardusWallpaperPrefs" parent="AdwPreferencesPage">
    <property name="title" translatable="yes">General</property>
    <property name="icon-name">preferences-system-symbolic</property>
    
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Live Wallpapers</property>
        <property name="description" translatable="yes">Automatically download and shuffle wallpapers</property>
        
        <child>
          <object class="AdwSwitchRow" id="enable_switch">
            <property name="title" translatable="yes">Enable Live Wallpapers</property>
            <property name="subtitle" translatable="yes">Download and shuffle wallpapers automatically</property>
          </object>
        </child>
        
        <child>
          <object class="AdwSpinRow" id="shuffle_interval">
            <property name="title" translatable="yes">Shuffle Interval</property>
            <property name="subtitle" translatable="yes">Time between wallpaper changes (minutes)</property>
            <property name="adjustment">
              <object class="GtkAdjustment">
                <property name="lower">1</property>
                <property name="upper">1440</property>
                <property name="step-increment">1</property>
                <property name="page-increment">10</property>
                <property name="value">30</property>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
    
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Wallpaper Sources</property>
        <property name="description" translatable="yes">Select which sources to download from</property>
        
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Configure sources in the panel menu</property>
            <property name="subtitle" translatable="yes">Click the wallpaper icon in the top panel to manage sources</property>
          </object>
        </child>
      </object>
    </child>
    
  </template>
</interface>
