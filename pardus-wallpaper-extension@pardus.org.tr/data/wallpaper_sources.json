{
  "sources": {
    "nasa": {
      "name": "NASA APOD",
      "description": "NASA Astronomy Picture of the Day - Nasa Daily",
      "enabled": true,
      "api_url": "https://api.nasa.gov/planetary/apod?api_key=DEMO_KEY",
      "headers": {
        "User-Agent": "PardusGnomeGreeter/1.0 (https://github.com/pardus/pardus-gnome-greeter) Python/requests"
      },
      "rate_limit": {
        "requests_per_hour": 30,
        "retry_delay": 60
      },
      "response_mapping": {
        "data_path": "",
        "title_keys": [
          "title"
        ],
        "description_keys": [
          "explanation"
        ],
        "image_url_keys": [
          "hdurl",
          "url"
        ],
        "thumbnail_url_keys": [
          "url"
        ],
        "image_url_prefix": ""
      },
      "validation": {
        "required_fields": [
          "url",
          "media_type"
        ],
        "media_type_check": "image"
      }
    },
    "wikipedia": {
      "name": "Wikipedia POTD",
      "description": "Wikipedia Picture of the Day",
      "enabled": true,
      "api_url": "https://en.wikipedia.org/api/rest_v1/feed/featured/{year}/{month:02d}/{day:02d}",
      "headers": {
        "User-Agent": "PardusGnomeGreeter/1.0 (https://github.com/pardus/pardus-gnome-greeter) Python/requests"
      },
      "response_mapping": {
        "data_path": "image",
        "title_keys": [
          "title"
        ],
        "description_keys": [
          "description.text"
        ],
        "image_url_keys": [
          "image.source"
        ],
        "thumbnail_url_keys": [
          "thumbnail.source"
        ],
        "image_url_prefix": "",
        "title_transform": {
          "type": "remove_prefix",
          "prefix": "File:"
        }
      },
      "validation": {
        "required_fields": [
          "image"
        ],
        "image_check": "image.image.source"
      }
    }
  }
}